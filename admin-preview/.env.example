# ریشهٔ API ادمین.
#
# حالت ۱ — دامنهٔ جدا یا پیش‌نمایش (مرورگر مستقیم به API وصل می‌شود):
VITE_ADMIN_API_BASE=https://centralmine.org/v1
#
# حالت ۲ — دیپلوی روی همان دامنهٔ API (بدون CORS، از طریق reverse proxy).
# این حالت برای پروداکشن توصیه می‌شود:
# VITE_ADMIN_API_BASE=/v1

# اگر پنل زیر یک subpath سرو می‌شود (مثلاً /admin) این را تنظیم کنید تا
# assetها 404 نشوند. فقط روی بیلد اثر دارد.
# VITE_BASE=/admin/

# کلید پنل که بک‌اند در AdminGuard/AuthGuard بررسی می‌کند.
# ⚠️ این مقدار داخل باندل مرورگر قرار می‌گیرد و محرمانه نیست.
VITE_ADMIN_PANEL_KEY=adm-panel-2026-11-08-7QmR9pX2
